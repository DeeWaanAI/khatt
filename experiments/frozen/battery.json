{
 "meta": {
  "name": "action-battery-v1",
  "frozen": "2026-10-19",
  "note": "Frozen before first run. Each action executes against a fresh, identically-seeded store. 'setup' actions run first and are NOT measured; their produced ids are referenced as @name in params.",
  "seeds": [
   {"path": "reports/q1.txt", "content": "Q1 v1\n"},
   {"path": "reports/q2.txt", "content": "Q2 v1\n"},
   {"path": "notes/todo.txt", "content": "todo v1\n"},
   {"path": "docs/spec-draft.txt", "content": "draft v1\n"},
   {"path": "assets/logo.txt", "content": "logo v1\n"}
  ]
 },
 "actions": [
  {"id": "A01", "verbatim": "create a Q3 report", "action_type": "file.create",
   "params": {"path": "reports/q3.txt", "content": "Q3 v1\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A02", "verbatim": "make a shopping list", "action_type": "file.create",
   "params": {"path": "notes/shopping.txt", "content": "milk\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A03", "verbatim": "write meeting minutes", "action_type": "file.create",
   "params": {"path": "docs/minutes.txt", "content": "minutes\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A04", "verbatim": "add a banner", "action_type": "file.create",
   "params": {"path": "assets/banner.txt", "content": "banner\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A05", "verbatim": "make an archive folder", "action_type": "dir.create",
   "params": {"path": "reports/archive"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A06", "verbatim": "make a 2026 docs folder", "action_type": "dir.create",
   "params": {"path": "docs/2026"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A07", "verbatim": "fix the Q1 numbers", "action_type": "file.edit",
   "params": {"path": "reports/q1.txt", "content": "Q1 v2\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A08", "verbatim": "update my todos", "action_type": "file.edit",
   "params": {"path": "notes/todo.txt", "content": "todo v2\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A09", "verbatim": "revise the spec draft", "action_type": "file.edit",
   "params": {"path": "docs/spec-draft.txt", "content": "draft v2\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A10", "verbatim": "touch up the logo", "action_type": "file.edit",
   "params": {"path": "assets/logo.txt", "content": "logo v2\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A11", "verbatim": "move Q2 next to a moved copy", "action_type": "file.move",
   "params": {"src": "reports/q2.txt", "dst": "reports/q2-moved.txt"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A12", "verbatim": "move the spec into v2", "action_type": "file.move",
   "params": {"src": "docs/spec-draft.txt", "dst": "docs/spec-v2.txt"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A13", "verbatim": "call Q1 final", "action_type": "file.rename",
   "params": {"src": "reports/q1.txt", "dst": "reports/q1-final.txt"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A14", "verbatim": "rename todos to v2", "action_type": "file.rename",
   "params": {"src": "notes/todo.txt", "dst": "notes/todo-v2.txt"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A15", "verbatim": "delete the logo", "action_type": "file.delete",
   "params": {"path": "assets/logo.txt"}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}},
  {"id": "A16", "verbatim": "delete my todos", "action_type": "file.delete",
   "params": {"path": "notes/todo.txt"}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}},
  {"id": "A17", "verbatim": "delete Q1", "action_type": "file.delete",
   "params": {"path": "reports/q1.txt"}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}},
  {"id": "A18", "verbatim": "delete the spec draft", "action_type": "file.delete",
   "params": {"path": "docs/spec-draft.txt"}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}},
  {"id": "A19", "verbatim": "delete the temp file in tmpdir", "action_type": "file.delete",
   "setup": [
    {"name": "d1", "action_type": "dir.create", "params": {"path": "notes/tmpdir"}},
    {"name": "f1", "action_type": "file.create", "params": {"path": "notes/tmpdir/x.txt", "content": "x\n"}}],
   "params": {"path": "notes/tmpdir/x.txt"}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}},
  {"id": "A20", "verbatim": "delete the whole tmp folder", "action_type": "dir.delete",
   "setup": [
    {"name": "d2", "action_type": "dir.create", "params": {"path": "notes/tmpdir2"}},
    {"name": "f2", "action_type": "file.create", "params": {"path": "notes/tmpdir2/y.txt", "content": "y\n"}}],
   "params": {"path": "notes/tmpdir2"}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}},
  {"id": "A21", "verbatim": "book focus time monday", "action_type": "calendar.create",
   "params": {"title": "focus", "start": "2026-10-20T09:00", "end": "2026-10-20T10:00"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A22", "verbatim": "book dentist", "action_type": "calendar.create",
   "params": {"title": "dentist", "start": "2026-10-21T15:00", "end": "2026-10-21T16:00"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A23", "verbatim": "book a call with sam", "action_type": "calendar.create",
   "params": {"title": "call sam", "start": "2026-10-22T11:00", "end": "2026-10-22T11:30"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A24", "verbatim": "move the focus block to 10am", "action_type": "calendar.update",
   "setup": [
    {"name": "ev", "action_type": "calendar.create", "params": {"title": "focus", "start": "2026-10-20T09:00", "end": "2026-10-20T10:00"}}],
   "params": {"event_id": "@ev", "fields": {"start": "2026-10-20T10:00"}}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}},
  {"id": "A25", "verbatim": "cancel the dentist", "action_type": "calendar.delete",
   "setup": [
    {"name": "ev", "action_type": "calendar.create", "params": {"title": "dentist", "start": "2026-10-21T15:00", "end": "2026-10-21T16:00"}}],
   "params": {"event_id": "@ev"}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}},
  {"id": "A26", "verbatim": "draft a note to sam", "action_type": "email.draft_create",
   "params": {"to": "sam@example.com", "subject": "hi", "body": "hello sam\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A27", "verbatim": "draft an update to the team", "action_type": "email.draft_create",
   "params": {"to": "team@example.com", "subject": "update", "body": "status...\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A28", "verbatim": "change the subject of sam's draft", "action_type": "email.draft_edit",
   "setup": [
    {"name": "dr", "action_type": "email.draft_create", "params": {"to": "sam@example.com", "subject": "hi", "body": "hello\n"}}],
   "params": {"draft_id": "@dr", "fields": {"subject": "hello instead"}}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A29", "verbatim": "discard that draft", "action_type": "email.draft_discard",
   "setup": [
    {"name": "dr", "action_type": "email.draft_create", "params": {"to": "sam@example.com", "subject": "hi", "body": "hello\n"}}],
   "params": {"draft_id": "@dr"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A30", "verbatim": "actually send the note to sam", "action_type": "email.send",
   "setup": [
    {"name": "dr", "action_type": "email.draft_create", "params": {"to": "sam@example.com", "subject": "hi", "body": "hello\n"}}],
   "params": {"draft_id": "@dr"}, "confirm": true,
   "expect": {"status": "success", "class": "IRREVERSIBLE", "undo": "impossible"}},
  {"id": "A31", "verbatim": "purge the deleted Q2 forever", "action_type": "trash.purge",
   "setup": [
    {"name": "del", "action_type": "file.delete", "params": {"path": "reports/q2.txt"}}],
   "params": {"trash_id": "@del"}, "confirm": true,
   "expect": {"status": "success", "class": "IRREVERSIBLE", "undo": "impossible"}},
  {"id": "A32", "verbatim": "make a deep folder", "action_type": "dir.create",
   "params": {"path": "reports/deep/nested"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A33", "verbatim": "put a file deep down", "action_type": "file.create",
   "params": {"path": "reports/deep/nested/a.txt", "content": "a\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A34", "verbatim": "edit the deep file", "action_type": "file.edit",
   "setup": [
    {"name": "dd", "action_type": "dir.create", "params": {"path": "reports/deep/nested"}},
    {"name": "df", "action_type": "file.create", "params": {"path": "reports/deep/nested/b.txt", "content": "b v1\n"}}],
   "params": {"path": "reports/deep/nested/b.txt", "content": "b v2\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A35", "verbatim": "create a unicode note", "action_type": "file.create",
   "params": {"path": "notes/cafe.txt", "content": "café — 数据\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A36", "verbatim": "write a big file", "action_type": "file.edit",
   "params": {"path": "reports/q1.txt", "content": "__BIG__"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A37", "verbatim": "create then undo twice", "action_type": "file.create",
   "params": {"path": "notes/dup.txt", "content": "d\n"}, "expect": {"status": "success", "class": "EXACT", "undo": "idempotent"}},
  {"id": "A38", "verbatim": "edit q2 but someone touches it after", "action_type": "file.edit",
   "params": {"path": "reports/q2.txt", "content": "Q2 agent-edit\n"},
   "post_modify": {"path": "reports/q2.txt", "content": "Q2 human-edit\n"},
   "expect": {"status": "success", "class": "EXACT", "undo": "conflict"}},
  {"id": "A39", "verbatim": "move Q1 into a folder that does not exist yet", "action_type": "file.move",
   "params": {"src": "reports/q1.txt", "dst": "reports/newfold/q1.txt"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A40", "verbatim": "draft a long note to the board", "action_type": "email.draft_create",
   "params": {"to": "board@example.com", "subject": "quarterly", "body": "__BIG__"}, "expect": {"status": "success", "class": "EXACT", "undo": "exact"}},
  {"id": "A41", "verbatim": "delete an empty old folder", "action_type": "dir.delete",
   "setup": [
    {"name": "od", "action_type": "dir.create", "params": {"path": "reports/old"}}],
   "params": {"path": "reports/old"}, "expect": {"status": "success", "class": "COMPENSABLE", "undo": "exact"}}
 ]
}
