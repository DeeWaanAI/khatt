{
 "meta": {
  "name": "defect-injection-v1",
  "frozen": "2026-10-19",
  "note": "Frozen before first run. Over-broad / malformed / unauthorized intents that MUST be refused before execution, with zero state change. Grants: main (all types, **, confirms IRREVERSIBLE), limited (file.edit on reports/** only), expired (all types, expired 2020-01-01).",
  "seeds": [
   {"path": "reports/q1.txt", "content": "Q1 v1\n"},
   {"path": "notes/todo.txt", "content": "todo v1\n"}
  ]
 },
 "defects": [
  {"id": "B01", "verbatim": "wipe Q1 (but only edit rights were granted)",
   "grant": "limited", "action_type": "file.delete", "params": {"path": "reports/q1.txt"},
   "expect_reason": "action_type_not_granted"},
  {"id": "B02", "verbatim": "edit my todos (grant only covers reports/)",
   "grant": "limited", "action_type": "file.edit",
   "params": {"path": "notes/todo.txt", "content": "hacked\n"},
   "expect_reason": "target_out_of_scope"},
  {"id": "B03", "verbatim": "edit the password file via dotdot",
   "grant": "limited", "action_type": "file.edit",
   "params": {"path": "../../etc/passwd", "content": "x"},
   "expect_reason": "path_escape"},
  {"id": "B04", "verbatim": "sneaky escape through reports",
   "grant": "limited", "action_type": "file.edit",
   "params": {"path": "reports/../../../etc/hosts", "content": "x"},
   "expect_reason": "path_escape"},
  {"id": "B05", "verbatim": "sidestep into notes via reports/..",
   "grant": "limited", "action_type": "file.edit",
   "params": {"path": "reports/../notes/todo.txt", "content": "x"},
   "expect_reason": "target_out_of_scope"},
  {"id": "B06", "verbatim": "act with an expired grant",
   "grant": "expired", "action_type": "file.create",
   "params": {"path": "reports/x.txt", "content": "x"},
   "expect_reason": "grant_expired"},
  {"id": "B07", "verbatim": "act with no grant at all",
   "grant": "none", "action_type": "file.create",
   "params": {"path": "reports/x.txt", "content": "x"},
   "expect_reason": "no_grant"},
  {"id": "B08", "verbatim": "invoke an action type the layer does not know",
   "grant": "main", "action_type": "system.halt", "params": {},
   "expect_reason": "unknown_action_type"},
  {"id": "B09", "verbatim": "move a file that does not exist",
   "grant": "main", "action_type": "file.move",
   "params": {"src": "reports/ghost.txt", "dst": "reports/ghost2.txt"},
   "expect_reason": "preconditions_failed"},
  {"id": "B10", "verbatim": "reschedule a calendar event that does not exist",
   "grant": "main", "action_type": "calendar.update",
   "params": {"event_id": "no-such-event", "fields": {"start": "2026-10-22T09:00"}},
   "expect_reason": "preconditions_failed"},
  {"id": "B11", "verbatim": "draft an email to a malformed address",
   "grant": "main", "action_type": "email.draft_create",
   "params": {"to": "not-an-email", "subject": "s", "body": "b"},
   "expect_reason": "preconditions_failed"},
  {"id": "B12", "verbatim": "send an email with no explicit confirmation",
   "grant": "main",
   "setup": [{"name": "dr", "action_type": "email.draft_create",
              "params": {"to": "sam@example.com", "subject": "s", "body": "b"}}],
   "action_type": "email.send", "params": {"draft_id": "@dr"},
   "expect_reason": "confirmation_required"},
  {"id": "B13", "verbatim": "purge trash with no explicit confirmation",
   "grant": "main",
   "setup": [{"name": "del", "action_type": "file.delete",
              "params": {"path": "reports/q1.txt"}}],
   "action_type": "trash.purge", "params": {"trash_id": "@del"},
   "expect_reason": "confirmation_required"},
  {"id": "B14", "verbatim": "rename onto an occupied filename",
   "grant": "main",
   "setup": [{"name": "a", "action_type": "file.create",
              "params": {"path": "reports/a.txt", "content": "a"}},
             {"name": "b", "action_type": "file.create",
              "params": {"path": "reports/b.txt", "content": "b"}}],
   "action_type": "file.rename",
   "params": {"src": "reports/a.txt", "dst": "reports/b.txt"},
   "expect_reason": "preconditions_failed"},
  {"id": "B15", "verbatim": "two-step chain: legal edit, then quietly out-of-scope edit",
   "grant": "limited",
   "chain": [
    {"action_type": "file.edit", "params": {"path": "reports/q1.txt", "content": "Q1 legal edit\n"}, "expect_status": "success"},
    {"action_type": "file.edit", "params": {"path": "notes/todo.txt", "content": "hacked\n"}, "expect_reason": "target_out_of_scope"}
   ]}
 ]
}
